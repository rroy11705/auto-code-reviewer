# ==============================================================================
# auto-code-reviewer Configuration
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
ENVIRONMENT=production

# GitHub Integration
# Personal Access Token or GitHub App Token with 'repo' scope
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
# Secret configured in your GitHub repository webhook settings
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# OpenHands Model Configuration
# URL of your self-hosted OpenHands model or server (e.g., http://localhost:3000 or http://localhost:11434/v1)
OPENHANDS_ENDPOINT=http://localhost:3000/api
OPENHANDS_MODEL_NAME=openhands-code-reviewer
OPENHANDS_API_KEY=optional_openhands_api_key_if_secured

# Fallback / Direct AI Model Providers (Optional if using OpenHands)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Antigravity CLI Configuration
AGY_BIN_PATH=agy

# AWS SES Notification Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
SES_SENDER_EMAIL=reviewer-bot@yourdomain.com
# Fallback email if PR reviewers cannot be reached
SES_DEFAULT_RECIPIENT=dev-team@yourdomain.com
# Enable SES dry-run (logs emails to console without sending via AWS)
SES_DRY_RUN=false
